{
  "name": "dsh-theme-tuner",
  "version": "0.1.2",
  "description": "DSH web plugin: theme customization placed under the built-in Appearance (外观) settings. It reuses the Appearance light/dark switch and lets you adjust accent / background / foreground / contrast for the active theme, applied live through DSH theme token overrides.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "scripts",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shawnlone/dsh-theme-tuner.git"
  },
  "homepage": "https://github.com/shawnlone/dsh-theme-tuner",
  "bugs": {
    "url": "https://github.com/shawnlone/dsh-theme-tuner/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "theme-tuner",
    "appearance",
    "plugin"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.1-rc.2 <=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-store": ">=0.1.1-rc.2 <=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc.2 <=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.1-rc.2 <=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.1-rc.2 <=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.1.1-rc.2 <=0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": ">=0.1.1-rc.2 <=0.1.2-rc.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-store": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
